generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiCall {
  id             String       @id
  apiTokenId     String
  organizationId String
  method         String
  path           String
  statusCode     Int
  createdAt      DateTime     @default(now())
  ApiToken       ApiToken     @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([apiTokenId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([apiTokenId, createdAt])
}

model ApiToken {
  id             String       @id
  name           String
  tokenHash      String       @unique
  organizationId String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  ApiCall        ApiCall[]
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tokenHash])
}

model Category {
  id             String         @id
  name           String
  description    String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  itemTemplate   Json           @default("[]")
  organizationId String
  Organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ItemCategory   ItemCategory[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model EventLog {
  id             String       @id
  organizationId String
  eventType      String
  entityType     String
  entityId       String
  data           Json
  createdAt      DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, eventType])
  @@index([organizationId])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           UserRole     @default(USER)
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  User           User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([email])
  @@index([organizationId])
  @@index([token])
}

model Issue {
  id             String       @id
  title          String
  description    String?
  status         String       @default("open")
  priority       String       @default("medium")
  assignedTo     String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  imageUrl       String?
  category       String?
  tags           String[]
  attachments    Json?
  comments       Json?
  dueDate        DateTime?
  resolvedAt     DateTime?
  resolution     String?
  metadata       Json?
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdBy])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Item {
  id                  String         @id
  name                String
  description         String?
  imageUrl            String?
  templateFields      Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  itemTemplate        Json           @default("[]")
  evidenceID          String?
  evidenceDataJson    String?
  createdByUserId     String?
  organizationId      String
  antifraudEvidenceId String?
  User                User?          @relation(fields: [createdByUserId], references: [id])
  Organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ItemCategory        ItemCategory[]
  State               State[]

  @@index([createdByUserId])
  @@index([organizationId])
}

model ItemCategory {
  itemId     String
  categoryId String
  Category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([itemId, categoryId])
  @@index([categoryId])
  @@index([itemId])
}

model Notification {
  id             String           @id
  userId         String
  type           NotificationType
  title          String
  message        String
  read           Boolean          @default(false)
  readAt         DateTime?
  data           Json?
  createdAt      DateTime         @default(now())
  organizationId String
  Organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([read])
  @@index([userId])
}

model Organization {
  id                String             @id
  nombre            String
  slug              String             @unique
  dominio           String?            @unique
  activa            Boolean            @default(true)
  plan              String             @default("basic")
  limites           Json?
  configuracion      Json?
  signatureID        String?            @unique
  kycURL            String?
  verificationStatus VerificationStatus @default(NOT_VERIFIED)
  createdAt         DateTime           @default(now())
  updatedAt          DateTime
  ApiCall           ApiCall[]
  ApiToken          ApiToken[]
  Category          Category[]
  EventLog          EventLog[]
  Invitation        Invitation[]
  Issue             Issue[]
  Item              Item[]
  Notification      Notification[]
  StatusType        StatusType[]
  User              User[]
  Webhook           Webhook[]
  ImportJob         ImportJob[]

  @@index([activa])
  @@index([slug])
  @@index([signatureID])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model State {
  id              String     @id
  itemId          String
  statusTypeId    String
  title           String
  description     String
  evidenceID      String
  backed          Boolean    @default(false)
  backedAt        DateTime?
  imageUrls       Json?
  templateConfig  Json?
  createdAt       DateTime   @default(now())
  createdByUserId String?
  issueDataJson   String?
  User            User?      @relation(fields: [createdByUserId], references: [id])
  Item            Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  StatusType      StatusType @relation(fields: [statusTypeId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([createdByUserId])
  @@index([itemId])
  @@index([statusTypeId])
}

model StatusType {
  id             String       @id
  name           String
  description    String       @default("")
  template       Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  organizationId String
  State          State[]
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                   String               @id
  email                String               @unique
  password             String?
  name                 String
  role                 UserRole             @default(USER)
  signsWithCertificate Boolean              @default(false)
  phone                String?
  permissions          Json?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  organizationId       String?
  activationToken      String?
  activatedAt          DateTime?
  status               UserStatus           @default(ACTIVE)
  activationExpiresAt  DateTime?
  Invitation           Invitation[]
  Item                 Item[]
  Notification         Notification[]
  PasswordResetToken   PasswordResetToken[]
  State                State[]
  Organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ImportJobUploadedBy  ImportJob[]          @relation("ImportJobUploadedBy")
  ImportJobExecutedBy  ImportJob[]          @relation("ImportJobExecutedBy")

  @@index([email])
  @@index([organizationId, email])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

model Webhook {
  id              String       @id
  organizationId  String
  name            String
  url             String
  secret          String?
  events          String[]
  active          Boolean      @default(true)
  headers         Json?
  lastTriggeredAt DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  failureCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  Organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@index([organizationId])
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  NOT_VERIFIED
  WAITING
  VERIFIED
  REJECTED
}

model ImportJob {
  id             String       @id
  organizationId String
  fileName       String
  fileUrl        String
  fileSize       Int
  status         ImportStatus @default(PENDING)
  uploadedBy     String
  executedBy     String?
  rowCount       Int?
  createdCount   Int?
  errorDetails   Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  UploadedByUser User         @relation("ImportJobUploadedBy", fields: [uploadedBy], references: [id])
  ExecutedByUser User?        @relation("ImportJobExecutedBy", fields: [executedBy], references: [id])

  @@index([organizationId, status])
  @@index([status])
  @@index([createdAt])
  @@map("ImportJob")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
